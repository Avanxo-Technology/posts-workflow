{
  "id": "iris-reveal",
  "name": "Iris (apertura circular)",
  "kind": "transition",
  "medium": "video",
  "tags": [
    "transicion",
    "circulo",
    "pantalla-completa",
    "css"
  ],
  "audio": null,
  "spec": 1,
  "snippet": "fx.css",
  "fx": {
    "css": "fx.css",
    "html": "fx.html",
    "params": {
      "duration": {
        "label": "Duración",
        "type": "number",
        "unit": "s",
        "default": 0.9,
        "min": 0.1,
        "max": 3,
        "step": 0.05
      },
      "delay": {
        "label": "Retraso (segundo de entrada)",
        "type": "number",
        "unit": "s",
        "default": 0,
        "min": 0,
        "max": 30,
        "step": 0.05
      },
      "mode": {
        "label": "Modo",
        "type": "enum",
        "default": "both",
        "options": [
          {
            "value": "both",
            "label": "Cierra y abre",
            "vars": {
              "--fx-mode": "fx-iris-both"
            }
          },
          {
            "value": "close",
            "label": "Solo cierra (cubre)",
            "vars": {
              "--fx-mode": "fx-iris-close"
            }
          },
          {
            "value": "open",
            "label": "Solo abre (revela)",
            "vars": {
              "--fx-mode": "fx-iris-open"
            }
          }
        ]
      },
      "color": {
        "label": "Color de la cortina",
        "type": "color",
        "default": "palette.accent"
      },
      "ringColor": {
        "label": "Color del aro",
        "type": "color",
        "default": "palette.light"
      },
      "ring": {
        "label": "Grosor del aro",
        "type": "number",
        "unit": "%",
        "default": 3,
        "min": 0,
        "max": 15,
        "step": 0.5
      },
      "x": {
        "label": "Centro horizontal",
        "type": "number",
        "unit": "%",
        "default": 50,
        "min": 0,
        "max": 100,
        "step": 1
      },
      "y": {
        "label": "Centro vertical",
        "type": "number",
        "unit": "%",
        "default": 50,
        "min": 0,
        "max": 100,
        "step": 1
      },
      "ease": {
        "label": "Curva",
        "type": "enum",
        "default": "in-out",
        "options": [
          {
            "value": "suave",
            "label": "Rebote suave",
            "vars": {
              "--fx-ease": "cubic-bezier(.2,.8,.2,1)"
            }
          },
          {
            "value": "lineal",
            "label": "Lineal",
            "vars": {
              "--fx-ease": "linear"
            }
          },
          {
            "value": "in-out",
            "label": "Entrada y salida",
            "vars": {
              "--fx-ease": "cubic-bezier(.65,0,.35,1)"
            }
          },
          {
            "value": "brusco",
            "label": "Brusco",
            "vars": {
              "--fx-ease": "cubic-bezier(.7,0,.3,1)"
            }
          }
        ]
      }
    },
    "markers": [
      {
        "at": 0.5,
        "label": "Pantalla cubierta (modo «cierra y abre»): cambia la escena aquí"
      }
    ]
  }
}
