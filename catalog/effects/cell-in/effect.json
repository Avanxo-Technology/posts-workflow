{
  "id": "cell-in",
  "name": "Celdas que entran",
  "kind": "entrance",
  "medium": "video",
  "tags": [
    "collage",
    "celdas",
    "entrada"
  ],
  "snippet": "fx.css",
  "audio": null,
  "spec": 1,
  "fx": {
    "css": "fx.css",
    "html": "fx.html",
    "params": {
      "duration": {
        "label": "Duración",
        "type": "number",
        "unit": "s",
        "default": 0.5,
        "min": 0.1,
        "max": 3,
        "step": 0.05
      },
      "delay": {
        "label": "Retraso (segundo de entrada)",
        "type": "number",
        "unit": "s",
        "default": 0,
        "min": 0,
        "max": 30,
        "step": 0.05
      },
      "direction": {
        "label": "Entra desde",
        "type": "enum",
        "default": "left",
        "options": [
          {
            "value": "left",
            "label": "La izquierda",
            "vars": {
              "--fx-dx": "-1",
              "--fx-dy": "0"
            }
          },
          {
            "value": "right",
            "label": "La derecha",
            "vars": {
              "--fx-dx": "1",
              "--fx-dy": "0"
            }
          },
          {
            "value": "top",
            "label": "Arriba",
            "vars": {
              "--fx-dx": "0",
              "--fx-dy": "-1"
            }
          },
          {
            "value": "bottom",
            "label": "Abajo",
            "vars": {
              "--fx-dx": "0",
              "--fx-dy": "1"
            }
          }
        ]
      },
      "ease": {
        "label": "Curva",
        "type": "enum",
        "default": "suave",
        "options": [
          {
            "value": "suave",
            "label": "Rebote suave",
            "vars": {
              "--fx-ease": "cubic-bezier(.2,.8,.2,1)"
            }
          },
          {
            "value": "lineal",
            "label": "Lineal",
            "vars": {
              "--fx-ease": "linear"
            }
          },
          {
            "value": "in-out",
            "label": "Entrada y salida",
            "vars": {
              "--fx-ease": "cubic-bezier(.65,0,.35,1)"
            }
          },
          {
            "value": "brusco",
            "label": "Brusco",
            "vars": {
              "--fx-ease": "cubic-bezier(.7,0,.3,1)"
            }
          }
        ]
      }
    },
    "markers": [],
    "label": "Foto"
  }
}
