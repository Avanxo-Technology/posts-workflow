{
  "id": "progress-bar",
  "name": "Barra de progreso global",
  "kind": "overlay",
  "medium": "video",
  "tags": [
    "progreso",
    "barra",
    "overlay"
  ],
  "snippet": "fx.css",
  "audio": null,
  "spec": 1,
  "fx": {
    "css": "fx.css",
    "html": "fx.html",
    "params": {
      "duration": {
        "label": "Duración total del video",
        "type": "number",
        "unit": "s",
        "default": 10,
        "min": 0.1,
        "max": 120,
        "step": 0.05
      },
      "delay": {
        "label": "Retraso (segundo de entrada)",
        "type": "number",
        "unit": "s",
        "default": 0,
        "min": 0,
        "max": 30,
        "step": 0.05
      },
      "color": {
        "label": "Color",
        "type": "color",
        "default": "palette.accent"
      },
      "height": {
        "label": "Grosor",
        "type": "number",
        "unit": "px",
        "default": 7,
        "min": 2,
        "max": 40,
        "step": 1
      }
    },
    "markers": []
  }
}
