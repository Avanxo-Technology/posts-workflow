{
  "id": "sweep-panel",
  "name": "Barrido de panel",
  "kind": "transition",
  "medium": "video",
  "brands": [
    "gmaq"
  ],
  "tags": [
    "transicion",
    "panel",
    "pantalla-completa"
  ],
  "source": {
    "piece": "gmaq/noviembre/postVideos/postVideo3",
    "symbol": "@keyframes swp"
  },
  "snippet": "fx.css",
  "audio": {
    "sfx": "whoosh de transición",
    "sync": "mismo `--s` en gen_audio.py"
  },
  "spec": 1,
  "fx": {
    "css": "fx.css",
    "html": "fx.html",
    "params": {
      "duration": {
        "label": "Duración",
        "type": "number",
        "unit": "s",
        "default": 0.8,
        "min": 0.1,
        "max": 3,
        "step": 0.05
      },
      "delay": {
        "label": "Retraso (segundo de entrada)",
        "type": "number",
        "unit": "s",
        "default": 0,
        "min": 0,
        "max": 30,
        "step": 0.05
      },
      "color": {
        "label": "Color del panel",
        "type": "color",
        "default": "palette.accent"
      },
      "direction": {
        "label": "Dirección",
        "type": "enum",
        "default": "left",
        "options": [
          {
            "value": "left",
            "label": "De izquierda a derecha",
            "vars": {
              "--fx-dx": "-1",
              "--fx-dy": "0"
            }
          },
          {
            "value": "right",
            "label": "De derecha a izquierda",
            "vars": {
              "--fx-dx": "1",
              "--fx-dy": "0"
            }
          },
          {
            "value": "top",
            "label": "De arriba abajo",
            "vars": {
              "--fx-dx": "0",
              "--fx-dy": "-1"
            }
          },
          {
            "value": "bottom",
            "label": "De abajo arriba",
            "vars": {
              "--fx-dx": "0",
              "--fx-dy": "1"
            }
          }
        ]
      },
      "ease": {
        "label": "Curva",
        "type": "enum",
        "default": "in-out",
        "options": [
          {
            "value": "suave",
            "label": "Rebote suave",
            "vars": {
              "--fx-ease": "cubic-bezier(.2,.8,.2,1)"
            }
          },
          {
            "value": "lineal",
            "label": "Lineal",
            "vars": {
              "--fx-ease": "linear"
            }
          },
          {
            "value": "in-out",
            "label": "Entrada y salida",
            "vars": {
              "--fx-ease": "cubic-bezier(.65,0,.35,1)"
            }
          },
          {
            "value": "brusco",
            "label": "Brusco",
            "vars": {
              "--fx-ease": "cubic-bezier(.7,0,.3,1)"
            }
          }
        ]
      }
    },
    "markers": [
      {
        "at": 0.5,
        "label": "Pantalla cubierta: cambia la escena aquí"
      }
    ]
  }
}
