{
  "id": "door-swing",
  "name": "Puerta 3D",
  "kind": "transition",
  "medium": "video",
  "tags": [
    "transicion",
    "3d",
    "perspectiva",
    "pantalla-completa"
  ],
  "snippet": "fx.css",
  "audio": null,
  "spec": 1,
  "fx": {
    "css": "fx.css",
    "html": "fx.html",
    "params": {
      "duration": {
        "label": "Duración",
        "type": "number",
        "unit": "s",
        "default": 0.9,
        "min": 0.1,
        "max": 3,
        "step": 0.05
      },
      "delay": {
        "label": "Retraso (segundo de entrada)",
        "type": "number",
        "unit": "s",
        "default": 0,
        "min": 0,
        "max": 60,
        "step": 0.05
      },
      "mode": {
        "label": "Eje",
        "type": "enum",
        "default": "y",
        "options": [
          {
            "value": "y",
            "label": "Puerta lateral",
            "vars": {
              "--fx-mode": "fx-door-y",
              "--fx-origin": "0% 50%",
              "--fx-deg": "-100deg"
            }
          },
          {
            "value": "x",
            "label": "Pantalla que cae",
            "vars": {
              "--fx-mode": "fx-door-x",
              "--fx-origin": "50% 0%",
              "--fx-deg": "100deg"
            }
          }
        ]
      },
      "ease": {
        "label": "Curva",
        "type": "enum",
        "default": "in-out",
        "options": [
          {
            "value": "suave",
            "label": "Rebote suave",
            "vars": {
              "--fx-ease": "cubic-bezier(.2,.8,.2,1)"
            }
          },
          {
            "value": "lineal",
            "label": "Lineal",
            "vars": {
              "--fx-ease": "linear"
            }
          },
          {
            "value": "in-out",
            "label": "Entrada y salida",
            "vars": {
              "--fx-ease": "cubic-bezier(.6,0,.3,1)"
            }
          },
          {
            "value": "brusco",
            "label": "Brusco",
            "vars": {
              "--fx-ease": "cubic-bezier(.7,0,.3,1)"
            }
          }
        ]
      }
    },
    "markers": [
      {
        "at": 1.0
      }
    ]
  }
}
