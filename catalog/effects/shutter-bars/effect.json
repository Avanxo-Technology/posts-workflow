{
  "id": "shutter-bars",
  "name": "Persianas alternas",
  "kind": "transition",
  "medium": "video",
  "tags": [
    "transicion",
    "canvas",
    "pantalla-completa"
  ],
  "snippet": "fx.css",
  "audio": {
    "sfx": "tr_bars",
    "sync": "la pantalla queda 100% cubierta en ~t0+.52; la escena siguiente empieza ahí"
  },
  "spec": 1,
  "fx": {
    "css": "fx.css",
    "html": "fx.html",
    "params": {
      "duration": {
        "label": "Duración",
        "type": "number",
        "unit": "s",
        "default": 0.9,
        "min": 0.1,
        "max": 3,
        "step": 0.05
      },
      "delay": {
        "label": "Retraso (segundo de entrada)",
        "type": "number",
        "unit": "s",
        "default": 0,
        "min": 0,
        "max": 30,
        "step": 0.05
      },
      "color1": {
        "label": "Barras impares",
        "type": "color",
        "default": "palette.dark"
      },
      "color2": {
        "label": "Barras pares",
        "type": "color",
        "default": "palette.accent"
      }
    },
    "markers": [
      {
        "expr": "delay + duration * 0.62",
        "label": "Pantalla cubierta: cambia la escena aquí"
      }
    ],
    "total": "delay + duration * 1.107"
  }
}
