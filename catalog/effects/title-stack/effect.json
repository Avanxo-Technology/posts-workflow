{
  "id": "title-stack",
  "name": "Título, subtítulo y etiqueta",
  "kind": "overlay",
  "medium": "video",
  "tags": [
    "varios-elementos",
    "titulo",
    "subtitulo",
    "etiqueta",
    "entrada"
  ],
  "snippet": "fx.css",
  "spec": 1,
  "fx": {
    "css": "fx.css",
    "html": "fx.html",
    "params": {
      "duration": {
        "label": "Duración de cada elemento",
        "type": "number",
        "unit": "s",
        "default": 0.6,
        "min": 0.1,
        "max": 3,
        "step": 0.05
      },
      "delay": {
        "label": "Retraso (segundo de entrada)",
        "type": "number",
        "unit": "s",
        "default": 0,
        "min": 0,
        "max": 30,
        "step": 0.05
      },
      "gap": {
        "label": "Retraso entre elementos",
        "type": "number",
        "unit": "s",
        "default": 0.18,
        "min": 0,
        "max": 1.5,
        "step": 0.02
      },
      "distance": {
        "label": "Distancia de entrada",
        "type": "number",
        "unit": "px",
        "default": 140,
        "min": 20,
        "max": 600,
        "step": 10
      },
      "ease": {
        "label": "Curva",
        "type": "enum",
        "default": "suave",
        "options": [
          {
            "value": "suave",
            "label": "Rebote suave",
            "vars": {
              "--fx-ease": "cubic-bezier(.2,.8,.2,1)"
            }
          },
          {
            "value": "lineal",
            "label": "Lineal",
            "vars": {
              "--fx-ease": "linear"
            }
          },
          {
            "value": "in-out",
            "label": "Entrada y salida",
            "vars": {
              "--fx-ease": "cubic-bezier(.65,0,.35,1)"
            }
          },
          {
            "value": "brusco",
            "label": "Brusco",
            "vars": {
              "--fx-ease": "cubic-bezier(.7,0,.3,1)"
            }
          }
        ]
      }
    },
    "label": "Título grande",
    "total": "delay + 2 * gap + duration",
    "markers": []
  }
}
