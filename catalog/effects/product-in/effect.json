{
  "id": "product-in",
  "name": "Producto que entra",
  "kind": "entrance",
  "medium": "video",
  "tags": [
    "producto",
    "imagen",
    "giro",
    "rebote"
  ],
  "snippet": "fx.css",
  "audio": null,
  "spec": 1,
  "fx": {
    "css": "fx.css",
    "html": "fx.html",
    "params": {
      "duration": {
        "label": "Duración",
        "type": "number",
        "unit": "s",
        "default": 0.55,
        "min": 0.1,
        "max": 3,
        "step": 0.05
      },
      "delay": {
        "label": "Retraso (segundo de entrada)",
        "type": "number",
        "unit": "s",
        "default": 0,
        "min": 0,
        "max": 30,
        "step": 0.05
      },
      "distance": {
        "label": "Distancia de entrada",
        "type": "number",
        "unit": "px",
        "default": 700,
        "min": 100,
        "max": 1200,
        "step": 10
      },
      "rotate": {
        "label": "Giro final",
        "type": "number",
        "unit": "deg",
        "default": 0,
        "min": -30,
        "max": 30,
        "step": 1
      },
      "spin": {
        "label": "Giro extra al entrar",
        "type": "number",
        "unit": "deg",
        "default": 0,
        "min": -90,
        "max": 90,
        "step": 1
      },
      "bounce": {
        "label": "Rebote",
        "type": "number",
        "unit": "px",
        "default": 16,
        "min": 0,
        "max": 60,
        "step": 1
      },
      "from": {
        "label": "Entra desde",
        "type": "enum",
        "default": "bottom",
        "options": [
          {
            "value": "bottom",
            "label": "Abajo",
            "vars": {
              "--fx-dx": "0",
              "--fx-dy": "1"
            }
          },
          {
            "value": "top",
            "label": "Arriba",
            "vars": {
              "--fx-dx": "0",
              "--fx-dy": "-1"
            }
          },
          {
            "value": "left",
            "label": "La izquierda",
            "vars": {
              "--fx-dx": "-1",
              "--fx-dy": "0"
            }
          },
          {
            "value": "right",
            "label": "La derecha",
            "vars": {
              "--fx-dx": "1",
              "--fx-dy": "0"
            }
          }
        ]
      },
      "ease": {
        "label": "Curva",
        "type": "enum",
        "default": "suave",
        "options": [
          {
            "value": "suave",
            "label": "Rebote suave",
            "vars": {
              "--fx-ease": "cubic-bezier(.2,.8,.2,1)"
            }
          },
          {
            "value": "lineal",
            "label": "Lineal",
            "vars": {
              "--fx-ease": "linear"
            }
          },
          {
            "value": "in-out",
            "label": "Entrada y salida",
            "vars": {
              "--fx-ease": "cubic-bezier(.65,0,.35,1)"
            }
          },
          {
            "value": "brusco",
            "label": "Brusco",
            "vars": {
              "--fx-ease": "cubic-bezier(.7,0,.3,1)"
            }
          }
        ]
      }
    },
    "markers": [],
    "label": "Producto"
  }
}
