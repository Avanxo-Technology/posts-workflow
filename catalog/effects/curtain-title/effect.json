{
  "id": "curtain-title",
  "name": "Cortina que revela título y subtítulo",
  "kind": "transition",
  "medium": "video",
  "tags": [
    "varios-elementos",
    "cortina",
    "titulo",
    "transicion"
  ],
  "snippet": "fx.css",
  "spec": 1,
  "fx": {
    "css": "fx.css",
    "html": "fx.html",
    "params": {
      "duration": {
        "label": "Duración de la apertura",
        "type": "number",
        "unit": "s",
        "default": 1.0,
        "min": 0.2,
        "max": 4,
        "step": 0.05
      },
      "delay": {
        "label": "Retraso (segundo de entrada)",
        "type": "number",
        "unit": "s",
        "default": 0,
        "min": 0,
        "max": 30,
        "step": 0.05
      },
      "color1": {
        "label": "Color de la cortina de arriba",
        "type": "color",
        "default": "palette.light"
      },
      "color2": {
        "label": "Color de la cortina de abajo",
        "type": "color",
        "default": "palette.accent"
      },
      "ease": {
        "label": "Curva",
        "type": "enum",
        "default": "suave",
        "options": [
          {
            "value": "suave",
            "label": "Rebote suave",
            "vars": {
              "--fx-ease": "cubic-bezier(.2,.8,.2,1)"
            }
          },
          {
            "value": "lineal",
            "label": "Lineal",
            "vars": {
              "--fx-ease": "linear"
            }
          },
          {
            "value": "in-out",
            "label": "Entrada y salida",
            "vars": {
              "--fx-ease": "cubic-bezier(.65,0,.35,1)"
            }
          },
          {
            "value": "brusco",
            "label": "Brusco",
            "vars": {
              "--fx-ease": "cubic-bezier(.7,0,.3,1)"
            }
          }
        ]
      }
    },
    "label": "Bienvenido",
    "total": "delay + duration",
    "markers": [
      {
        "at": 0.5,
        "label": "cortinas a medio abrir"
      }
    ]
  }
}
