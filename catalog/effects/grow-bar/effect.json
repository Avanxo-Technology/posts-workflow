{
  "id": "grow-bar",
  "name": "Barra que crece",
  "kind": "entrance",
  "medium": "video",
  "tags": [
    "linea",
    "barra",
    "subrayado"
  ],
  "snippet": "fx.css",
  "audio": null,
  "spec": 1,
  "fx": {
    "css": "fx.css",
    "html": "fx.html",
    "params": {
      "duration": {
        "label": "Duración",
        "type": "number",
        "unit": "s",
        "default": 0.5,
        "min": 0.1,
        "max": 3,
        "step": 0.05
      },
      "delay": {
        "label": "Retraso (segundo de entrada)",
        "type": "number",
        "unit": "s",
        "default": 0,
        "min": 0,
        "max": 30,
        "step": 0.05
      },
      "width": {
        "label": "Ancho",
        "type": "number",
        "unit": "px",
        "default": 520,
        "min": 10,
        "max": 1000,
        "step": 10
      },
      "height": {
        "label": "Alto",
        "type": "number",
        "unit": "px",
        "default": 14,
        "min": 2,
        "max": 400,
        "step": 1
      },
      "color": {
        "label": "Color",
        "type": "color",
        "default": "palette.accent"
      },
      "grow": {
        "label": "Crece",
        "type": "enum",
        "default": "izq",
        "options": [
          {
            "value": "izq",
            "label": "Horizontal, desde la izquierda",
            "vars": {
              "--fx-sx0": "0",
              "--fx-sy0": "1",
              "--fx-ox": "0%",
              "--fx-oy": "50%"
            }
          },
          {
            "value": "centro",
            "label": "Horizontal, desde el centro",
            "vars": {
              "--fx-sx0": "0",
              "--fx-sy0": "1",
              "--fx-ox": "50%",
              "--fx-oy": "50%"
            }
          },
          {
            "value": "der",
            "label": "Horizontal, desde la derecha",
            "vars": {
              "--fx-sx0": "0",
              "--fx-sy0": "1",
              "--fx-ox": "100%",
              "--fx-oy": "50%"
            }
          },
          {
            "value": "arriba",
            "label": "Vertical, desde arriba",
            "vars": {
              "--fx-sx0": "1",
              "--fx-sy0": "0",
              "--fx-ox": "50%",
              "--fx-oy": "0%"
            }
          },
          {
            "value": "abajo",
            "label": "Vertical, desde abajo",
            "vars": {
              "--fx-sx0": "1",
              "--fx-sy0": "0",
              "--fx-ox": "50%",
              "--fx-oy": "100%"
            }
          }
        ]
      },
      "ease": {
        "label": "Curva",
        "type": "enum",
        "default": "suave",
        "options": [
          {
            "value": "suave",
            "label": "Rebote suave",
            "vars": {
              "--fx-ease": "cubic-bezier(.2,.8,.2,1)"
            }
          },
          {
            "value": "lineal",
            "label": "Lineal",
            "vars": {
              "--fx-ease": "linear"
            }
          },
          {
            "value": "in-out",
            "label": "Entrada y salida",
            "vars": {
              "--fx-ease": "cubic-bezier(.65,0,.35,1)"
            }
          },
          {
            "value": "brusco",
            "label": "Brusco",
            "vars": {
              "--fx-ease": "cubic-bezier(.7,0,.3,1)"
            }
          }
        ]
      }
    },
    "markers": []
  }
}
