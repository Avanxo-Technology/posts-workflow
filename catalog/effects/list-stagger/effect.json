{
  "id": "list-stagger",
  "name": "Lista escalonada",
  "kind": "overlay",
  "medium": "video",
  "tags": [
    "varios-elementos",
    "lista",
    "escalonado",
    "entrada"
  ],
  "snippet": "fx.css",
  "spec": 1,
  "fx": {
    "css": "fx.css",
    "html": "fx.html",
    "params": {
      "duration": {
        "label": "Duración de cada fila",
        "type": "number",
        "unit": "s",
        "default": 0.5,
        "min": 0.1,
        "max": 3,
        "step": 0.05
      },
      "delay": {
        "label": "Retraso (segundo de entrada)",
        "type": "number",
        "unit": "s",
        "default": 0,
        "min": 0,
        "max": 30,
        "step": 0.05
      },
      "gap": {
        "label": "Retraso entre filas",
        "type": "number",
        "unit": "s",
        "default": 0.15,
        "min": 0,
        "max": 1,
        "step": 0.02
      },
      "distance": {
        "label": "Distancia de entrada",
        "type": "number",
        "unit": "px",
        "default": 520,
        "min": 50,
        "max": 1200,
        "step": 10
      },
      "ease": {
        "label": "Curva",
        "type": "enum",
        "default": "suave",
        "options": [
          {
            "value": "suave",
            "label": "Rebote suave",
            "vars": {
              "--fx-ease": "cubic-bezier(.2,.8,.2,1)"
            }
          },
          {
            "value": "lineal",
            "label": "Lineal",
            "vars": {
              "--fx-ease": "linear"
            }
          },
          {
            "value": "in-out",
            "label": "Entrada y salida",
            "vars": {
              "--fx-ease": "cubic-bezier(.65,0,.35,1)"
            }
          },
          {
            "value": "brusco",
            "label": "Brusco",
            "vars": {
              "--fx-ease": "cubic-bezier(.7,0,.3,1)"
            }
          }
        ]
      }
    },
    "label": "Primer punto",
    "total": "delay + 3 * gap + duration",
    "markers": []
  }
}
