{
  "id": "clip-reveal",
  "name": "Revelado por máscara",
  "kind": "text",
  "medium": "video",
  "brands": [
    "gmaq",
    "gremco",
    "pirotecnia"
  ],
  "tags": [
    "texto",
    "mascara",
    "clip-path"
  ],
  "source": {
    "file": "_shared/base/video-template.html",
    "symbol": "@keyframes wipe"
  },
  "snippet": "fx.css",
  "audio": null,
  "spec": 1,
  "fx": {
    "css": "fx.css",
    "html": "fx.html",
    "params": {
      "duration": {
        "label": "Duración",
        "type": "number",
        "unit": "s",
        "default": 0.7,
        "min": 0.1,
        "max": 3,
        "step": 0.05
      },
      "delay": {
        "label": "Retraso (segundo de entrada)",
        "type": "number",
        "unit": "s",
        "default": 0,
        "min": 0,
        "max": 30,
        "step": 0.05
      },
      "direction": {
        "label": "Se descubre",
        "type": "enum",
        "default": "lr",
        "options": [
          {
            "value": "lr",
            "label": "De izquierda a derecha",
            "vars": {
              "--fx-clip": "inset(0 100% 0 0)"
            }
          },
          {
            "value": "rl",
            "label": "De derecha a izquierda",
            "vars": {
              "--fx-clip": "inset(0 0 0 100%)"
            }
          },
          {
            "value": "tb",
            "label": "De arriba abajo",
            "vars": {
              "--fx-clip": "inset(0 0 100% 0)"
            }
          },
          {
            "value": "bt",
            "label": "De abajo arriba",
            "vars": {
              "--fx-clip": "inset(100% 0 0 0)"
            }
          }
        ]
      },
      "ease": {
        "label": "Curva",
        "type": "enum",
        "default": "in-out",
        "options": [
          {
            "value": "suave",
            "label": "Rebote suave",
            "vars": {
              "--fx-ease": "cubic-bezier(.2,.8,.2,1)"
            }
          },
          {
            "value": "lineal",
            "label": "Lineal",
            "vars": {
              "--fx-ease": "linear"
            }
          },
          {
            "value": "in-out",
            "label": "Entrada y salida",
            "vars": {
              "--fx-ease": "cubic-bezier(.65,0,.35,1)"
            }
          },
          {
            "value": "brusco",
            "label": "Brusco",
            "vars": {
              "--fx-ease": "cubic-bezier(.7,0,.3,1)"
            }
          }
        ]
      }
    },
    "markers": [],
    "label": "Texto revelado"
  }
}
