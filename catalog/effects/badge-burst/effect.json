{
  "id": "badge-burst",
  "name": "Título con insignias",
  "kind": "overlay",
  "medium": "video",
  "tags": [
    "varios-elementos",
    "insignias",
    "pop",
    "entrada"
  ],
  "snippet": "fx.css",
  "spec": 1,
  "fx": {
    "css": "fx.css",
    "html": "fx.html",
    "params": {
      "duration": {
        "label": "Duración de cada elemento",
        "type": "number",
        "unit": "s",
        "default": 0.5,
        "min": 0.1,
        "max": 3,
        "step": 0.05
      },
      "delay": {
        "label": "Retraso (segundo de entrada)",
        "type": "number",
        "unit": "s",
        "default": 0,
        "min": 0,
        "max": 30,
        "step": 0.05
      },
      "gap": {
        "label": "Retraso entre elementos",
        "type": "number",
        "unit": "s",
        "default": 0.2,
        "min": 0,
        "max": 1.5,
        "step": 0.02
      },
      "overshoot": {
        "label": "Rebote (escala máxima)",
        "type": "number",
        "unit": "",
        "default": 1.15,
        "min": 1,
        "max": 1.6,
        "step": 0.01
      },
      "ease": {
        "label": "Curva",
        "type": "enum",
        "default": "suave",
        "options": [
          {
            "value": "suave",
            "label": "Rebote suave",
            "vars": {
              "--fx-ease": "cubic-bezier(.2,.8,.2,1)"
            }
          },
          {
            "value": "lineal",
            "label": "Lineal",
            "vars": {
              "--fx-ease": "linear"
            }
          },
          {
            "value": "in-out",
            "label": "Entrada y salida",
            "vars": {
              "--fx-ease": "cubic-bezier(.65,0,.35,1)"
            }
          },
          {
            "value": "brusco",
            "label": "Brusco",
            "vars": {
              "--fx-ease": "cubic-bezier(.7,0,.3,1)"
            }
          }
        ]
      }
    },
    "label": "Gran oferta",
    "total": "delay + 2 * gap + duration",
    "markers": []
  }
}
