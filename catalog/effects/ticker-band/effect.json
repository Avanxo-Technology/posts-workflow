{
  "id": "ticker-band",
  "name": "Cinta de texto en movimiento",
  "kind": "overlay",
  "medium": "video",
  "tags": [
    "texto",
    "marquesina",
    "fondo",
    "bucle"
  ],
  "snippet": "fx.css",
  "audio": null,
  "spec": 1,
  "fx": {
    "css": "fx.css",
    "html": "fx.html",
    "params": {
      "duration": {
        "label": "Duración",
        "type": "number",
        "unit": "s",
        "default": 8,
        "min": 0.1,
        "max": 40,
        "step": 0.05
      },
      "delay": {
        "label": "Retraso (segundo de entrada)",
        "type": "number",
        "unit": "s",
        "default": 0,
        "min": 0,
        "max": 60,
        "step": 0.05
      },
      "mode": {
        "label": "Sentido",
        "type": "enum",
        "default": "l",
        "options": [
          {
            "value": "l",
            "label": "Hacia la izquierda",
            "vars": {
              "--fx-mode": "fx-tk-l"
            }
          },
          {
            "value": "r",
            "label": "Hacia la derecha",
            "vars": {
              "--fx-mode": "fx-tk-r"
            }
          }
        ]
      }
    },
    "markers": []
  }
}
