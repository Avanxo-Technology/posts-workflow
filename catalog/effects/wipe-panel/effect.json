{
  "id": "wipe-panel",
  "name": "Panel naranja que barre",
  "kind": "transition",
  "medium": "video",
  "tags": [
    "transicion",
    "panel",
    "pantalla-completa"
  ],
  "snippet": "fx.css",
  "audio": {
    "sfx": "whoosh de transición",
    "sync": "sincroniza el sonido con el inicio del barrido (`--fx-delay`)"
  },
  "spec": 1,
  "fx": {
    "css": "fx.css",
    "html": "fx.html",
    "params": {
      "duration": {
        "label": "Duración",
        "type": "number",
        "unit": "s",
        "default": 0.8,
        "min": 0.1,
        "max": 3,
        "step": 0.05
      },
      "delay": {
        "label": "Retraso (segundo de entrada)",
        "type": "number",
        "unit": "s",
        "default": 0,
        "min": 0,
        "max": 30,
        "step": 0.05
      },
      "color": {
        "label": "Color del panel",
        "type": "color",
        "default": "palette.accent"
      },
      "edgeColor": {
        "label": "Color del borde",
        "type": "color",
        "default": "palette.dark"
      },
      "edge": {
        "label": "Grosor del borde",
        "type": "number",
        "unit": "px",
        "default": 90,
        "min": 0,
        "max": 300,
        "step": 5
      },
      "skew": {
        "label": "Inclinación",
        "type": "number",
        "unit": "deg",
        "default": -12,
        "min": -30,
        "max": 30,
        "step": 1
      },
      "ease": {
        "label": "Curva",
        "type": "enum",
        "default": "in-out",
        "options": [
          {
            "value": "suave",
            "label": "Rebote suave",
            "vars": {
              "--fx-ease": "cubic-bezier(.2,.8,.2,1)"
            }
          },
          {
            "value": "lineal",
            "label": "Lineal",
            "vars": {
              "--fx-ease": "linear"
            }
          },
          {
            "value": "in-out",
            "label": "Entrada y salida",
            "vars": {
              "--fx-ease": "cubic-bezier(.65,0,.35,1)"
            }
          },
          {
            "value": "brusco",
            "label": "Brusco",
            "vars": {
              "--fx-ease": "cubic-bezier(.7,0,.3,1)"
            }
          }
        ]
      }
    },
    "markers": [
      {
        "at": 0.5,
        "label": "Pantalla cubierta: cambia la escena aquí"
      }
    ]
  }
}
