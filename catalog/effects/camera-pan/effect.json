{
  "id": "camera-pan",
  "name": "Paneo de cámara",
  "kind": "camera",
  "medium": "video",
  "tags": [
    "foto",
    "paneo",
    "video-fondo"
  ],
  "snippet": "fx.css",
  "audio": null,
  "spec": 1,
  "fx": {
    "css": "fx.css",
    "html": "fx.html",
    "params": {
      "duration": {
        "label": "Duración",
        "type": "number",
        "unit": "s",
        "default": 4,
        "min": 0.1,
        "max": 20,
        "step": 0.05
      },
      "delay": {
        "label": "Retraso (segundo de entrada)",
        "type": "number",
        "unit": "s",
        "default": 0,
        "min": 0,
        "max": 30,
        "step": 0.05
      },
      "scale": {
        "label": "Escala (zoom fijo)",
        "type": "number",
        "unit": "",
        "default": 1.14,
        "min": 1,
        "max": 1.6,
        "step": 0.01
      },
      "pan": {
        "label": "Recorrido",
        "type": "number",
        "unit": "%",
        "default": 3,
        "min": 0,
        "max": 15,
        "step": 0.5
      },
      "direction": {
        "label": "Se mueve hacia",
        "type": "enum",
        "default": "left",
        "options": [
          {
            "value": "left",
            "label": "La izquierda",
            "vars": {
              "--fx-dir": "1"
            }
          },
          {
            "value": "right",
            "label": "La derecha",
            "vars": {
              "--fx-dir": "-1"
            }
          }
        ]
      },
      "ease": {
        "label": "Curva",
        "type": "enum",
        "default": "lineal",
        "options": [
          {
            "value": "suave",
            "label": "Rebote suave",
            "vars": {
              "--fx-ease": "cubic-bezier(.2,.8,.2,1)"
            }
          },
          {
            "value": "lineal",
            "label": "Lineal",
            "vars": {
              "--fx-ease": "linear"
            }
          },
          {
            "value": "in-out",
            "label": "Entrada y salida",
            "vars": {
              "--fx-ease": "cubic-bezier(.65,0,.35,1)"
            }
          },
          {
            "value": "brusco",
            "label": "Brusco",
            "vars": {
              "--fx-ease": "cubic-bezier(.7,0,.3,1)"
            }
          }
        ]
      }
    },
    "markers": []
  }
}
