{
  "id": "fly-elements",
  "name": "Escena con tus elementos (posición, origen y destino)",
  "kind": "overlay",
  "medium": "video",
  "tags": [
    "varios-elementos",
    "posicion",
    "origen",
    "escena",
    "entrada"
  ],
  "snippet": "fx.css",
  "spec": 1,
  "fx": {
    "css": "fx.css",
    "html": "fx.html",
    "params": {
      "duration": {
        "label": "Duración de cada elemento",
        "type": "number",
        "unit": "s",
        "default": 0.7,
        "min": 0.1,
        "max": 5,
        "step": 0.05
      },
      "delay": {
        "label": "Retraso (segundo de entrada)",
        "type": "number",
        "unit": "s",
        "default": 0,
        "min": 0,
        "max": 30,
        "step": 0.05
      },
      "gap": {
        "label": "Retraso entre elementos",
        "type": "number",
        "unit": "s",
        "default": 0.2,
        "min": 0,
        "max": 2,
        "step": 0.05
      },
      "ease": {
        "label": "Curva",
        "type": "enum",
        "default": "suave",
        "options": [
          {
            "value": "suave",
            "label": "Rebote suave",
            "vars": {
              "--fx-ease": "cubic-bezier(.2,.8,.2,1)"
            }
          },
          {
            "value": "lineal",
            "label": "Lineal",
            "vars": {
              "--fx-ease": "linear"
            }
          },
          {
            "value": "in-out",
            "label": "Entrada y salida",
            "vars": {
              "--fx-ease": "cubic-bezier(.65,0,.35,1)"
            }
          },
          {
            "value": "brusco",
            "label": "Brusco",
            "vars": {
              "--fx-ease": "cubic-bezier(.7,0,.3,1)"
            }
          }
        ]
      }
    },
    "items": {
      "max": 8,
      "defaults": [
        {
          "text": "Título grande",
          "x": 50,
          "y": 38,
          "from": "bottom",
          "size": 120,
          "color": "palette.light"
        },
        {
          "text": "Subtítulo de apoyo",
          "x": 50,
          "y": 50,
          "from": "left",
          "size": 56,
          "color": "palette.light"
        },
        {
          "text": "NUEVO",
          "x": 80,
          "y": 26,
          "from": "center",
          "size": 52,
          "color": "palette.dark",
          "bg": "palette.accent"
        }
      ]
    },
    "markers": []
  }
}
