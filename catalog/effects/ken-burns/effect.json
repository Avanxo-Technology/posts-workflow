{
  "id": "ken-burns",
  "name": "Zoom lento (Ken Burns)",
  "kind": "camera",
  "medium": "video",
  "brands": [
    "aga",
    "gmaq",
    "gremco",
    "pirotecnia"
  ],
  "tags": [
    "foto",
    "zoom",
    "video-fondo"
  ],
  "source": {
    "file": "_shared/base/video-template.html",
    "symbol": "@keyframes kb"
  },
  "snippet": "fx.css",
  "audio": null,
  "spec": 1,
  "fx": {
    "css": "fx.css",
    "html": "fx.html",
    "params": {
      "duration": {
        "label": "Duración",
        "type": "number",
        "unit": "s",
        "default": 4,
        "min": 0.1,
        "max": 20,
        "step": 0.05
      },
      "delay": {
        "label": "Retraso (segundo de entrada)",
        "type": "number",
        "unit": "s",
        "default": 0,
        "min": 0,
        "max": 30,
        "step": 0.05
      },
      "from": {
        "label": "Escala inicial",
        "type": "number",
        "unit": "",
        "default": 1,
        "min": 0.8,
        "max": 2,
        "step": 0.01
      },
      "to": {
        "label": "Escala final",
        "type": "number",
        "unit": "",
        "default": 1.16,
        "min": 0.8,
        "max": 2,
        "step": 0.01
      },
      "panX": {
        "label": "Desplazamiento horizontal",
        "type": "number",
        "unit": "%",
        "default": 0,
        "min": -20,
        "max": 20,
        "step": 0.5
      },
      "panY": {
        "label": "Desplazamiento vertical",
        "type": "number",
        "unit": "%",
        "default": 0,
        "min": -20,
        "max": 20,
        "step": 0.5
      },
      "ease": {
        "label": "Curva",
        "type": "enum",
        "default": "lineal",
        "options": [
          {
            "value": "suave",
            "label": "Rebote suave",
            "vars": {
              "--fx-ease": "cubic-bezier(.2,.8,.2,1)"
            }
          },
          {
            "value": "lineal",
            "label": "Lineal",
            "vars": {
              "--fx-ease": "linear"
            }
          },
          {
            "value": "in-out",
            "label": "Entrada y salida",
            "vars": {
              "--fx-ease": "cubic-bezier(.65,0,.35,1)"
            }
          },
          {
            "value": "brusco",
            "label": "Brusco",
            "vars": {
              "--fx-ease": "cubic-bezier(.7,0,.3,1)"
            }
          }
        ]
      }
    },
    "markers": []
  }
}
